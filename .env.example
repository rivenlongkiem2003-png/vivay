# Use the Supabase Postgres connection string. Keep it in Vercel Environment
# Variables and never commit the real value. Prefer the Supavisor session
# pooler connection for the serverless runtime.
DATABASE_URL=
DATABASE_SSL=true
NODE_ENV=development
PORT=3000
SESSION_SECRET=
PUBLIC_ORIGIN=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Set true for one deployment only to reset an existing bootstrap admin password.
BOOTSTRAP_ADMIN_RESET=false
# Keep false until the owner has completed the legal deployment checklist.
OWNER_PRODUCTION_APPROVED=false
# Keep the pool small because each Vercel warm function can hold its own pool.
DB_POOL_MAX=3
