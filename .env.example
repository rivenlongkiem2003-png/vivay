# DATABASE_URL is populated locally by `neon link` / `neon env pull`.
# Never commit the real values in this file.
DATABASE_URL=
DATABASE_SSL=
NODE_ENV=development
PORT=3000
SESSION_SECRET=
PUBLIC_ORIGIN=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Keep false until the owner has completed the legal deployment checklist.
OWNER_PRODUCTION_APPROVED=false
# Neon Functions uses a small pool per warm isolate.
DB_POOL_MAX=3
