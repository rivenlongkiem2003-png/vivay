{
  "version": 2,
  "buildCommand": "npm run build",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30,
      "includeFiles": "{app.js,server-app.js,index.html,detail.html,admin.html,*.css,login.js,detail.js,admin.js,assets/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.mjs" }
  ]
}
