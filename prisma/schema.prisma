generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int      @id @default(autoincrement())
  name             String
  phone            String   @unique
  cccd             String
  hanThanhToan     String
  tienCanThanhToan String
  tienGiaiNgan     String
  ngayGiaiNgan     String?
  soTaiKhoan       String?
  nganHang         String?
  createdAt        DateTime @default(now())
}

model Admin {
  id                Int    @id @default(autoincrement())
  username          String @unique
  password          String
  stkDoanhNghiep    String
  nganHangChung     String
  tenChuDoanhNghiep String
  linkQrCode        String
}
